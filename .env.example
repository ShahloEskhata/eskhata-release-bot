# Токен от @BotFather
BOT_TOKEN=
# Telegram ID тех, кто может запускать /release (через запятую). Свой ID покажет команда /myid. Пусто — любой участник группы
ADMIN_IDS=
# Админы по username (без @, через запятую) — если ID неизвестен. Работает вместе с ADMIN_IDS
ADMIN_USERNAMES=
# ID групп, где бот работает, через запятую (покажет /myid в группе; у супергруппы вида -100…). Пусто — любая группа
ALLOWED_CHAT_ID=
# Как часто напоминать тем, кто не подтвердил (минуты)
REMIND_EVERY_MIN=60
# Напоминать только в рабочие часы, в часовом поясе TZ
WORK_HOURS=9-19
TZ_NAME=Asia/Dushanbe
# Когда слать админам утреннюю сводку по открытым релизам (по будням); пусто — не слать
DIGEST_TIME=09:30
# Кого тегать, когда срок релиза вышел, а задачи не закрыты (username без @, через запятую), например RM
RM_USERNAMES=

# Срок для кнопки «Создать до …» при автоопределении списка (пусто — кнопки нет)
DEFAULT_DEADLINE=17:00

# Задачи с кнопками — в личку тестировщику (если он писал боту /start); false — всё в группе, как раньше
TASKS_IN_DM=true

# Раз в рабочий день писать админам лично «бот работает» (время по TZ_NAME); пусто — не писать. После простоя бот сообщает об этом всегда
HEARTBEAT_TIME=09:00

# Кому слать служебные сообщения по релизу (предупреждение до срока, «можно выпускать», сводка, «задача не готова»):
# owner — только админу, создавшему релиз (если ему не доставить — остальным); all — всем админам
ADMIN_NOTIFY=owner

# По понедельникам (после DIGEST_TIME) админам лично — итоги прошлой недели; false — не слать
WEEKLY_STATS=true
